# ==============================================================================
# KHUYẾN NGHỊ BẢO MẬT: TRÁNH ĐỒNG BỘ ĐÁM MÂY (ONEDRIVE / DROPBOX / ICLOUD)
# ==============================================================================
# Nếu thư mục dự án nằm trong OneDrive, việc lưu .env tại thư mục gốc tiềm ẩn nguy cơ
# rò rỉ token lên đám mây. Khuyến nghị lưu tệp .env thực tế tại thư mục người dùng:
#   Windows: %USERPROFILE%\.gemini\.env (hoặc %USERPROFILE%\.agent-base\.env)
#   Linux/macOS: ~/.gemini/.env (hoặc ~/.agent-base/.env)
#
# ==============================================================================
# BỂ CẤU HÌNH ĐA TÀI KHOẢN GEMINI & CƠ CHẾ XOAY VÒNG TỰ ĐỘNG KHI HẾT HẠN
# ==============================================================================
# Hỗ trợ tối đa N tài khoản. Hệ thống tự động xoay vòng Round-Robin & Fallback
# khi gặp lỗi 429 (Hạn mức) hoặc lỗi 1016 (Token __Secure-1PSIDTS hết hạn).
# Khi hết hạn, token __Secure-1PSIDTS sẽ được tự động làm mới qua Google RPC
# và ghi đè trực tiếp vào file này mà không cần đăng nhập lại trình duyệt.

# Tài khoản 1 (Chính)
GEMINI_SECURE_1PSID="your_secure_1psid_account_1"
GEMINI_SECURE_1PSIDTS="your_secure_1psidts_account_1"

# Tài khoản 2 (Dự phòng 1)
GEMINI_SECURE_1PSID_2="your_secure_1psid_account_2"
GEMINI_SECURE_1PSIDTS_2="your_secure_1psidts_account_2"

# Tài khoản 3 (Dự phòng 2)
GEMINI_SECURE_1PSID_3="your_secure_1psid_account_3"
GEMINI_SECURE_1PSIDTS_3="your_secure_1psidts_account_3"

# Tài khoản 4 (Dự phòng 3)
GEMINI_SECURE_1PSID_4="your_secure_1psid_account_4"
GEMINI_SECURE_1PSIDTS_4="your_secure_1psidts_account_4"
